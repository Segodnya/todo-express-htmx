{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "nodemon -r tsconfig-paths/register src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:dev": "TS_NODE_TRANSPILE_ONLY=1 jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "knip": "knip"
  },
  "keywords": [],
  "author": "immortalsteel@gmail.com",
  "license": "ISC",
  "description": "Backend for the To-do App w/ Express and MongoDB",
  "dependencies": {
    "@types/express-ejs-layouts": "2.5.4",
    "bcrypt": "5.1.0",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-ejs-layouts": "2.5.1",
    "express-session": "1.18.1",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@jest/types": "29.6.3",
    "@types/bcrypt": "5.0.0",
    "@types/express": "5.0.0",
    "@types/express-session": "1.18.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.9.0",
    "concurrently": "9.1.2",
    "jest": "29.7.0",
    "knip": "5.46.5",
    "nodemon": "3.1.7",
    "ts-jest": "29.2.5",
    "tsc-alias": "1.8.10",
    "typescript": "5.6.3"
  }
}
