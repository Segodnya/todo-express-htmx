<%- include('../layouts/header') %>

<div class="bg-light-background dark:bg-dark-background flex flex-col justify-center py-12 sm:px-6 lg:px-8">
	<div class="sm:mx-auto sm:w-full sm:max-w-md">
		<h2 class="mt-6 text-center text-3xl font-extrabold text-light-text dark:text-dark-text">
			<%= t('auth:signup.title') %>
		</h2>
	</div>

	<div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
		<div class="card cardSection">
			<form class="space-y-6" hx-post="/auth/signup" hx-target="#form-messages" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful && event.detail.xhr.status === 200) window.location.href='/todos'" hx-indicator="#loading-indicator">

				<%- include('../partials/form-input', {
          id: 'name',
          label: t('auth:signup.name'),
          type: 'text',
          required: true
        }) %>

				<%- include('../partials/form-input', {
          id: 'email',
          label: t('auth:signup.email'),
          type: 'email',
          required: true
        }) %>

				<%- include('../partials/form-input', {
          id: 'password',
          label: t('auth:signup.password'),
          type: 'password',
          required: true
        }) %>

				<%- include('../partials/form-input', {
          id: 'confirmPassword',
          label: t('auth:signup.confirmPassword'),
          type: 'password',
          required: true
        }) %>

				<%- include('../partials/button', {
          type: 'submit',
          variant: 'primary',
          fullWidth: true,
          loading: true,
          loadingText: t('auth:signup.loading'),
          content: t('auth:signup.button')
        }) %>

				<div id="form-messages" class="mt-3" hx-swap-oob="true"></div>
			</form>

			<div class="mt-6">
				<div class="relative">
					<div class="relative flex justify-center text-sm">
						<span class="px-2 bg-light-card dark:bg-dark-card text-light-secondary dark:text-dark-secondary transition-colors duration-300">
							<%= t('auth:signup.haveAccount') %>
							<a href="/auth/signin" class="font-medium text-light-primary-600 dark:text-dark-primary-600 hover:text-light-primary-500 dark:hover:text-dark-primary-500 transition-colors duration-300">
								<%= t('auth:signup.signinLink') %>
							</a>
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<%- include('../layouts/footer') %>
