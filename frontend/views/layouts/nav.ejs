<!-- Navigation -->
<nav class="bg-light-card dark:bg-dark-card shadow transition-colors duration-300">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between h-16">
			<div class="flex">
				<div class="flex-shrink-0 flex items-center">
					<h1 class="text-xl font-bold text-light-text dark:text-dark-text"><%= t('app.title') %></h1>
				</div>
			</div>
			<div
				class="flex items-center">
				<!-- Theme Switcher -->
				<div class="mr-4">
					<%- include('../partials/theme-switcher') %>
				</div>
				<!-- Language Switcher -->
				<div class="mr-4">
					<%- include('../partials/language-switcher') %>
				</div>

				<% if (locals.user) { %>
					<span class="text-light-secondary dark:text-dark-secondary mr-4"><%= user.email %></span>
					<button hx-post="/auth/signout" class="btn btnPrimary">
						<span class="htmx-indicator hidden">
							<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</span>
						<%= t('header.logout') %>
					</button>
				<% } %>
			</div>
		</div>
	</div>
</nav>

