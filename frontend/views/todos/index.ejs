<%- include('../layouts/header') %>

<div class="max-w-4xl mx-auto">
    <div class="card">
        <!-- Add Todo Form -->
        <div class="cardSection border-b border-gray-200">
            <form class="mt-4" 
                  hx-post="/todos" 
                  hx-target="#todo-list"
                  hx-swap="beforeend">
                <div class="flex rounded-md shadow-sm">
                    <div class="flex-1">
                        <%- include('../partials/form-input', {
                            id: 'text',
                            label: '',
                            type: 'text',
                            required: true,
                            placeholder: 'What needs to be done?'
                        }) %>
                    </div>
                    <div class="ml-3 flex-shrink-0">
                        <%- include('../partials/button', {
                            type: 'submit',
                            variant: 'primary',
                            content: 'Add Todo',
                            loading: true,
                            loadingText: 'Adding...'
                        }) %>
                    </div>
                </div>
            </form>
        </div>

        <!-- Todo List -->
        <ul id="todo-list" class="listContainer">
            <% todos?.forEach(function(todo) { %>
                <%- include('../partials/todo-item', { todo }) %>
            <% }); %>
        </ul>
    </div>
</div>

<%- include('../layouts/footer') %> 