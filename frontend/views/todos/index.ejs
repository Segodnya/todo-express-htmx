<%- include('../layouts/header') %>

<div class="max-w-4xl mx-auto">
    <div class="card">
        <!-- Add Todo Form -->
        <div class="cardSection border-b border-gray-200">
            <form class="mt-4" 
                  hx-post="/todos" 
                  hx-target="#todo-list"
                  hx-swap="beforeend">
                <div class="flex rounded-md shadow-sm">
                    <div class="flex-1">
                        <%- include('../partials/form-input', {
                            id: 'text',
                            label: '',
                            type: 'text',
                            required: true,
                            placeholder: t('todos:add.placeholder')
                        }) %>
                    </div>
                    <div class="ml-3 flex-shrink-0">
                        <%- include('../partials/button', {
                            type: 'submit',
                            variant: 'primary',
                            content: t('todos:add.button'),
                            loading: true,
                            loadingText: t('todos:add.loading')
                        }) %>
                    </div>
                </div>
            </form>
        </div>

        <!-- Todo List -->
        <ul id="todo-list" class="listContainer">
            <% if (!todos || todos.length === 0) { %>
                <li class="p-4 text-center text-gray-500"><%= t('todos:empty') %></li>
            <% } else { %>
                <% todos?.forEach(function(todo) { %>
                    <%- include('../partials/todo-item', { todo }) %>
                <% }); %>
            <% } %>
        </ul>
    </div>
</div>

<%- include('../layouts/footer') %> 