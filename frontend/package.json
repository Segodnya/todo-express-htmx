{
  "name": "todo-express-htmx-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf public/js/* && rm -rf public/css/output.css*",
    "dev": "concurrently \"vite\" \"npm run dev:css\"",
    "build": "npm run clean && npm run build:css && vite build && npm run cleanup",
    "cleanup": "rm -rf public/js/css",
    "preview": "vite preview",
    "dev:css": "tailwindcss -i ./src/css/input.css -o ./public/css/output.css --watch",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/output.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.10",
    "@vitejs/plugin-legacy": "6.0.2",
    "concurrently": "8.2.2",
    "tailwindcss": "3.4.17",
    "vite": "6.2.5"
  }
}
